NODE_ENV=development
# local para npm start y el piloto. En Render, usar APP_RUNTIME=render y NODE_ENV=production.
APP_RUNTIME=local
HOST=127.0.0.1
# Render asigna PORT al servicio. Este valor corresponde a desarrollo local.
PORT=3000
FRONTEND_ORIGINS=http://localhost:8081,http://localhost:19006
TRUST_PROXY=0
# Solo en Render. IPs individuales de los pares TCP de ingreso aprobados, separadas por coma.
RENDER_TRUSTED_PROXY_IPS=
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
JSON_BODY_LIMIT_BYTES=65536

# /health solo comprueba el proceso. Render valida los roles habilitados al arrancar.
# URL del LOGIN lapape_catalog_render, miembro de lapape_render_catalog_select (NOLOGIN).
# Use sslmode=verify-full (require is also upgraded to verified TLS).
# pg 8.20 supports channel_binding=prefer, not strict channel_binding=require.
DATABASE_URL=
# Direct owner URL is reserved for explicitly authorized, manual migrations.
# Runtime configuration intentionally does not read this variable.
DATABASE_URL_UNPOOLED=
# Optional: true for verified TLS; false only for localhost outside production,
# when the URL does not explicitly require TLS or channel binding.
PG_SSL=

# Public read-only catalog API. Production does not allow the demo endpoint.
CATALOG_API_ENABLED=false
# Explicitly enable ONLY while testing on a trusted private LAN.
# Requires NODE_ENV=development and CATALOG_API_ENABLED=true.
CATALOG_DEMO_API_ENABLED=false

# Optional server-side Cloudinary configuration, disabled by default.
# This switch enables local validation; it does not mount uploads or open connections.
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Piloto local por defecto. En Render usar AUTH_MODE=hosted con AUTH_ALLOW_LOOPBACK_HTTP=false.
AUTH_ENABLED=false
AUTH_MODE=pilot
# Solo en Render: hostname sin credenciales del endpoint de identidad aprobado.
AUTH_DATABASE_HOST=
# URL de un endpoint distinto al del catálogo, con rol lapape_auth_runtime.
AUTH_DATABASE_URL=
# 32 bytes aleatorios codificados como Base64URL sin relleno.
AUTH_RATE_LIMIT_KEY=
AUTH_ALLOW_LOOPBACK_HTTP=false
