NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGINS=http://localhost:8081,http://localhost:19006
TRUST_PROXY=0
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
JSON_BODY_LIMIT_BYTES=65536

# Optional. GET /health and server startup never connect to PostgreSQL.
# Future API: pooled Neon URL for a read-only role, stored only in an ignored .env.
# Use sslmode=verify-full (require is also upgraded to verified TLS).
# pg 8.20 supports channel_binding=prefer, not strict channel_binding=require.
DATABASE_URL=
# Direct owner URL is reserved for explicitly authorized, manual migrations.
# Runtime configuration intentionally does not read this variable.
DATABASE_URL_UNPOOLED=
# Optional: true for verified TLS; false only for localhost outside production,
# when the URL does not explicitly require TLS or channel binding.
PG_SSL=
