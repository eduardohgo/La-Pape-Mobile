NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGINS=http://localhost:8081,http://localhost:19006
TRUST_PROXY=0
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
JSON_BODY_LIMIT_BYTES=65536

# Optional. Leave empty for the HTTP base; health never checks the database.
# Add actual credentials only to an ignored local .env or service environment.
DATABASE_URL=
# Optional: true for verified TLS; false only for localhost outside production.
PG_SSL=
