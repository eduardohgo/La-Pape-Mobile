
{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "developmentClient": false,
      "environment": "preview",
      "env": {
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_API_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "https://la-pape-mobile-auth-tigre10.onrender.com",
        "EXPO_PUBLIC_CATALOG_API_URL": "https://la-pape-mobile-catalogo-tigre10.onrender.com",
        "EXPO_PUBLIC_CATALOG_MODE": "commercial"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "developmentClient": false,
      "environment": "production",
      "env": {
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_API_ENV": "production",
        "EXPO_PUBLIC_CATALOG_MODE": "commercial"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
