{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node",
      "react-native"
    ],
    "rootDir": "src",
    "outDir": ".test-build"
  },
  "include": [
    "src/config/configuracion-api.ts",
    "src/services/**/*.ts",
    "src/utils/busqueda-catalogo.ts",
    "src/features/catalogo/dominio/**/*.ts",
    "src/features/catalogo/datos/**/*.ts",
    "src/features/catalogo/composicion.ts",
    "src/features/catalogo/presentacion/viewmodels.ts",
    "src/features/catalogo/presentacion/hooks.ts"
  ]
}
