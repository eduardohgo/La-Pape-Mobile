# Public configuration only. Replace the URL with the computer's LAN IPv4 for iPhone.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
EXPO_PUBLIC_API_ENV=development
EXPO_PUBLIC_API_TIMEOUT_MS=15000
# live: published catalog; demo: ten legacy ZIP previews in DEV Expo only.
# No secrets here. The demo endpoint requires an explicit backend flag.
EXPO_PUBLIC_CATALOG_MODE=live
